{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapline",
  "version": "0.1.0",
  "identifier": "io.github.aaronburt.snapline",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://thumb.localhost http://combine.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../third_party/ffmpeg/ffmpeg.exe": "ffmpeg.exe",
      "../../LICENSE": "LICENSE",
      "../../third_party/ffmpeg/LICENSE": "FFmpeg-LICENSE.txt",
      "../../third_party/ffmpeg/SOURCE.txt": "SOURCE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
