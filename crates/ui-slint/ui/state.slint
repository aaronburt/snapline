    callback copy-deletion-link(string);
    callback retry-upload();
    callback cancel-upload();
    callback cancel-row-upload(int);
    callback upload-to(string);
    callback ensure-destinations();
    callback search-changed(string);
    callback filter-changed(int);
    callback set-grid(bool);
    callback move-selection(int);
    callback activate-selected();
    callback copy-selected();
    callback delete-hotkey();
}

export struct ToolCardData {
    id: string,
    name: string,
    description: string,
    icon: string,
    hotkey: string,
    action: string,
}

export struct CombineSourceItem {
    kind: string,
    id: int,
    name: string,
    index: int,
}

export struct CombineHistoryItem {
    id: int,
    name: string,
}

export struct ConvertHistoryItem {
    id: int,
    name: string,
    meta: string,
}

export global ToolsState {
    in-out property <string> active-panel: "";
    in-out property <string> message;
    in-out property <string> query;
    in-out property <[ToolCardData]> cards;
    in-out property <bool> tool-busy: false;

    in-out property <string> qr-text;
