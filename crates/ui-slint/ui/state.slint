// Settings state shared by every page. Rust fills these from the services layer and
// receives edits through the update-* callbacks (see src/backend.rs and src/main.rs).
import { Tokens } from "tokens.slint";

export struct HotkeyFormatResult {
    status: string,
    value: string,
}

export struct MonitorItemData {
    number: string,
    resolution: string,
    left: float,
    top: float,
    width: float,
    height: float,
    primary: bool,
}

export struct HotkeyRowData {
    owner: string,
    label: string,
    description: string,
    chord: string,
    clash: string,
}

export global SettingsState {
    in property <string> app-version: "0.0.0";
    // Manual update check: "" (idle), or the short result shown next to the button.
    in-out property <string> update-message;
    in-out property <bool> update-checking: false;
    in-out property <string> update-url;
    callback check-updates();
    callback open-update();
    in-out property <bool> launch-at-sign-in: true;
    in-out property <bool> start-minimised: false;
    in-out property <bool> tray-click-capture: true;
    in-out property <bool> notifications: true;
    in-out property <string> save-folder;
    in-out property <string> subfolders;
    in-out property <string> image-format;
    in-out property <int> lossy-quality: 90;
    in-out property <int> zoom: 100;
    in property <[string]> zoom-options;
    callback update-zoom(string);
    callback zoom-step(int);
    in-out property <string> name-pattern;
    in-out property <string> preview-name;
    in-out property <string> copied-link-format;
    in-out property <[string]> subfolder-options;
    in-out property <[string]> image-format-options;
    in-out property <[string]> link-format-options;

    in-out property <bool> include-cursor: true;
    in-out property <string> capture-delay;
    in-out property <bool> shutter-sound: false;
    in-out property <bool> window-shadow: true;
    in-out property <bool> freeze-screen: true;
    in-out property <bool> magnifier: true;
    in-out property <string> magnifier-zoom;
    in-out property <bool> snap-windows: true;
    in-out property <bool> show-size: true;
    in-out property <bool> crosshair: false;
    in-out property <string> monitor-mode;
    in-out property <[MonitorItemData]> monitors;
    in-out property <int> monitors-total-w: 0;
    in-out property <int> monitors-total-h: 0;
    in-out property <string> monitor-caption: "Reading monitor layout…";
    in-out property <string> video-format;
    in-out property <string> frame-rate;
    in-out property <string> quality;
    in-out property <bool> system-audio: true;
    in-out property <bool> microphone: false;
    in-out property <string> microphone-device;
    in-out property <[string]> microphone-options;
    in-out property <bool> recording-border: true;
    in-out property <string> ffmpeg-path;
    in-out property <string> gif-frame-rate;
    in-out property <string> gif-width;
    in-out property <bool> optimise-palette: true;
    in-out property <[string]> capture-delay-options;
    in-out property <[string]> magnifier-zoom-options;
    in-out property <[string]> monitor-options;
    in-out property <[string]> video-format-options;
    in-out property <[string]> frame-rate-options;
    in-out property <[string]> quality-options;
    in-out property <[string]> gif-frame-rate-options;
    in-out property <[string]> gif-width-options;

    in-out property <string> capture-hotkey: "PrtSc";
    in-out property <[HotkeyRowData]> capture-hotkeys;
    in-out property <[HotkeyRowData]> recording-hotkeys;
    in-out property <[HotkeyRowData]> tool-hotkeys;
    in-out property <bool> take-over-prtsc: true;
    in-out property <bool> warn-clashes: true;
    in-out property <string> prtsc-hint;

    callback update-bool(string, bool);
    callback update-text(string, string);
    callback update-choice(string, string);
    callback update-number(string, int);
    callback update-chord(string, string);
    callback preview-name-requested(string);
    callback browse-folder();
    callback reset-ffmpeg();
    callback browse-ffmpeg();
    callback run-capture();
    pure callback text-matches(string, string, string) -> bool;
    pure callback hotkey-group-visible(string, string) -> bool;
    callback format-hotkey(string, bool, bool, bool, bool) -> HotkeyFormatResult;
}

export struct DestinationRowData {
    id: string,
    name: string,
    detail: string,
    status: string,
    configured: bool,
    kind: string,
    action: string,   // "Configure", "Edit" or "Set up"
    index: int,
}

// Upload settings and destination accounts. Rust fills these and handles the callbacks.
export global UploadsState {
    in-out property <string> images;
    in-out property <string> videos;
    in-out property <string> text;
    in-out property <string> other-files;
    in-out property <string> link-shortener;
    in-out property <[string]> images-options;
    in-out property <[string]> videos-options;
    in-out property <[string]> text-options;
    in-out property <[string]> other-options;
    in-out property <[string]> shortener-options;
    in-out property <bool> strip-exif: true;
    in-out property <bool> ask-clipboard: true;
    in-out property <string> retry;
    in-out property <string> timeout;
    in-out property <string> keep-history;
    in-out property <string> proxy;
    in-out property <string> custom-proxy;
    in-out property <[string]> retry-options;
    in-out property <[string]> timeout-options;
    in-out property <[string]> keep-history-options;
    in-out property <[string]> proxy-options;
    in-out property <[DestinationRowData]> destinations;
    in-out property <string> destination-error;
    in-out property <string> import-warning;
    in-out property <string> active-id;
    in-out property <bool> add-open: false;
    in-out property <bool> busy: false;

    callback update-choice(string, string);
    callback update-bool(string, bool);
    callback update-text(string, string);
    callback add-destination(string);
    callback import-sxcu();
    callback open-destination(string);
    callback close-destination();
    pure callback accounts-visible(string) -> bool;
}

export struct FormHeaderData {
    index: int,
    name: string,
    value: string,
    saved: bool,
}

export global DestinationForm {
    in-out property <string> kind;
    in-out property <string> title;
    in-out property <string> description;
    in-out property <string> error;
    in-out property <string> notice;
    in-out property <string> test-state: "idle";
    in-out property <string> test-message;
    in-out property <bool> confirm-delete: false;
    in-out property <bool> busy: false;

    // GitHub token for a Gist. Never sent back to the page, only its saved flag.
    in-out property <string> secret;
    in-out property <bool> secret-saved: false;
    // S3 ACL public-read, or a public Gist.
    in-out property <bool> acl-public-read: false;

    // Amazon S3. The public URL pattern is shared with SFTP.
    in-out property <string> endpoint;
    in-out property <string> region;
    in-out property <string> bucket;
    in-out property <string> path-prefix;
    in-out property <string> access-key-id;
    in-out property <bool> access-key-saved: false;
    in-out property <string> secret-access-key;
    in-out property <bool> secret-access-key-saved: false;
    in-out property <string> public-url-pattern;

    // SFTP
    in-out property <string> host;
    in-out property <string> port;
    in-out property <string> username;
    in-out property <bool> password-auth: true;     // false means private key file
    in-out property <string> password;
    in-out property <bool> password-saved: false;
    in-out property <string> private-key-path;
    in-out property <string> passphrase;
    in-out property <bool> passphrase-saved: false;
    in-out property <string> remote-folder;

    // Custom uploader
    in-out property <string> name;
    in-out property <string> method;
    in-out property <string> request-url;
    in-out property <string> body;
    in-out property <string> file-form-field;
    in-out property <string> link;
    in-out property <string> thumbnail;
    in-out property <string> deletion;
    in-out property <string> error-message;
    in-out property <[FormHeaderData]> headers;
    in-out property <bool> include-header-values: false;

    callback save-destination();
    callback test-destination();
    callback delete-destination();
    callback export-sxcu();
    callback add-header();
    callback header-name-edited(int, string);
    callback header-value-edited(int, string);
}

export struct WorkflowRowData {
    id: string,
    label: string,
    checked: bool,
    note: string,
}

// The default workflow ("what PrtSc does") shown on the General page.
export global WorkflowState {
    in-out property <[WorkflowRowData]> default-rows;
    in-out property <string> message;
    in-out property <int> workflow-count;
    callback toggle(int);            // row index
    callback move(int, int);         // row index, direction (-1 up, 1 down)
    callback open-workflows();
}

export struct WorkflowItemData {
    id: string,
    title: string,
    chord: string,
    chord-blocked: bool,
    steps: string,
    step-list: [string],
    clash: string,
    enabled: bool,
    is-default: bool,
}

export struct EditorStepData {
    label: string,
    icon: string,
    index: int,
    error: string,
    choices: [string],
    choice: string,
}

export global WorkflowsState {
    in-out property <[WorkflowItemData]> items;
    in-out property <bool> has-workflows: false;
    in-out property <string> message;
    in-out property <string> query;
    in-out property <bool> editing: false;
    in-out property <bool> is-new: false;
    in-out property <string> editor-title;
    in-out property <string> editor-name;
    in-out property <string> editor-hotkey;
    in-out property <string> editor-clash;
    in-out property <bool> editor-enabled: true;
    in-out property <bool> editor-is-default: false;
    in-out property <[EditorStepData]> editor-steps;
    in-out property <[string]> add-choices;
    in-out property <string> name-error;
    in-out property <string> list-error;
    in-out property <bool> confirm-delete: false;

    callback search-changed(string);
    callback new-workflow();
    callback edit(string);
    callback toggle(string, bool);
    callback back();
    callback save();
    callback duplicate();
    callback delete();
    callback name-edited(string);
    callback hotkey-committed(string);
    callback enabled-changed(bool);
    callback add-step(string);
    callback remove-step(int);
    callback move-step(int, int);
    callback step-choice(int, string);
}

export struct HistoryCellData {
    id: int,
    name: string,
    meta: string,
    tag: string,
    thumb: image,
    has-thumb: bool,
    selected: bool,
    index: int,
    day: string,
    duration: string,
    badge: string,
    badge-tone: string,
    type-label: string,
    captured: string,
    size: string,
    timed: string,
    progress: float,
    show-progress: bool,
    cancellable: bool,
}

export struct HistoryDestOption {
    id: string,
    name: string,
}

// One day: its heading and its captures.
export struct HistoryRowData {
    label: string,
    count: string,
    size: int,
    cells: [HistoryCellData],
}

// History page, mirroring ui/src/windows/main/history/HistoryPage.svelte and DetailPane.svelte.
