    in-out property <string> combine-error;
    in-out property <string> combine-notice;
    in-out property <int> combine-done-capture-id: -1;

    in-out property <[ConvertHistoryItem]> convert-history-choices;
    in-out property <string> convert-source-kind;
    in-out property <int> convert-capture-id: -1;
    in-out property <string> convert-file-path;
    in-out property <string> convert-source-label: "No video chosen";
    in-out property <string> convert-format: "GIF";
    in-out property <bool> convert-running: false;
