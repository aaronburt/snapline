    callback qr-text-edited(string);
    callback qr-open-link(string);
    callback qr-copy-text(string);
    callback qr-copy-image();
    callback qr-save-png();
    callback qr-scan-screen();
    callback qr-use-scanned();

    callback combine-pick-files();
    callback combine-add-history(int);
    callback combine-move-source(int, int);
    callback combine-remove-source(int);
    callback combine-options-changed();
    callback combine-save();
    callback combine-show-in-history();

    callback convert-pick-file();
    callback convert-choose-history(int);
    callback convert-start();
    callback convert-cancel();
