export global Tokens {
    in-out property <bool> light: false;
    out property <color> bg: light ? #f3f3f3 : #202020;
    out property <color> mica: light ? #eeeeee : #1c1c1c;
    out property <color> layer: light ? #f9f9f9 : #272727;
    out property <color> card: light ? #ffffff : #2d2d2d;
    out property <color> card-alt: light ? #f5f5f5 : #343434;
    out property <color> stroke: light ? #00000017 : #ffffff14;
    out property <color> stroke-hi: light ? #0000002e : #ffffff29;
    out property <color> text: light ? #1a1a1a : #ffffff;
    out property <color> text2: light ? #3b3b3b : #d0d0d0;
    out property <color> text3: light ? #5f5f5f : #a8a8a8;
    out property <color> accent: light ? #005fb8 : #60cdff;
    out property <color> accent-soft: light ? #005fb81a : #60cdff26;
    out property <color> transparent: #00000000;
    out property <color> on-accent: light ? #ffffff : #002a40;
    out property <color> subtle: light ? #0000000b : #ffffff0f;
    out property <color> ok: light ? #0f7b0f : #6ccb5f;
    out property <color> ok-soft: light ? #0f7b0f1a : #6ccb5f26;
    out property <color> err: light ? #c42b1c : #ff99a4;
    out property <color> err-soft: light ? #c42b1c1a : #ff99a424;
    out property <color> shadow: light ? #0000002e : #00000080;
    out property <color> menu-layer: light ? #f9f9f9 : #2c2c2c;
    out property <color> track: light ? #00000033 : #ffffff33;
    out property <color> overlay-pill: #000000b8;
    out property <color> on-overlay: #ffffff;
    out property <string> mono: "Cascadia Mono";
}
