import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";
import { Logo, Icon } from "widgets.slint";
import { SettingsState, WorkflowsState, HistoryState, ToolsState } from "state.slint";
import { GeneralPage } from "general_page.slint";
import { CapturePage } from "capture_page.slint";
import { HotkeysPage } from "hotkeys_page.slint";
import { UploadsPage } from "uploads_page.slint";
import { WorkflowsPage } from "workflows_page.slint";
import { HistoryPage } from "history_page.slint";
import { ToolsPage } from "tools_page.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> count;
    in property <bool> selected;
    in property <length> row-height: 38px;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    height: root.row-height;
    border-radius: 4px;
    background: root.selected ? Tokens.subtle : (ta.has-hover ? Tokens.subtle : transparent);
    if root.selected: Rectangle {
        x: 4px;
        y: (parent.height - 16px) / 2;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: Tokens.accent;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout { alignment: center; Icon { d: root.icon; size: 16px; tint: Tokens.text; } }
        Text { horizontal-stretch: 1; text: root.label; color: Tokens.text; font-size: 13px; vertical-alignment: center; overflow: elide; }
        if root.count != "": Text { text: root.count; color: Tokens.text3; font-size: 12px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component SnaplineWindow inherits Window {
    title: "Snapline";
    preferred-width: 1000px;
    preferred-height: 700px;
    min-width: 900px;
    min-height: 600px;
    background: Tokens.mica;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;

    in-out property <int> page: 0;
    in-out property <float> scroll-y: 0;
    in-out property <length> nav-width: 248px;
    in-out property <string> find;
    in-out property <string> settings-find;
    in-out property <string> history-find;
    in-out property <string> workflows-find;
    in-out property <string> tools-find;
    in-out property <string> history-count: "0";
    property <bool> find-disabled: (root.page == 4 && WorkflowsState.editing) || (root.page == 6 && ToolsState.active-panel != "");

    function sync-find-for-page() {
        if (root.page == 3) {
            root.find = root.history-find;
        } else if (root.page == 4) {
            root.find = root.workflows-find;
        } else if (root.page == 6) {
            root.find = root.tools-find;
        } else {
            root.find = root.settings-find;
        }
    }

    function apply-find(text: string) {
        if (root.page == 3) {
            root.history-find = text;
            HistoryState.search-changed(text);
        } else if (root.page == 4) {
            root.workflows-find = text;
            WorkflowsState.search-changed(text);
        } else if (root.page == 6) {
            root.tools-find = text;
            ToolsState.search-changed(text);
        } else {
            root.settings-find = text;
        }
    }

    changed page => {
        root.scroll-y = 0;
        root.sync-find-for-page();
    }

    zoom-keys := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.modifiers.control) {
                if (event.text == "=" || event.text == "+") {
                    SettingsState.zoom-step(1);
                    return accept;
                } else if (event.text == "-" || event.text == "_") {
                    SettingsState.zoom-step(-1);
                    return accept;
                } else if (event.text == "0") {
                    SettingsState.zoom-step(0);
                    return accept;
                }
            }
            reject
        }
    HorizontalLayout {
        VerticalLayout {
            width: root.nav-width;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            padding-bottom: 16px;
            spacing: 2px;
            Rectangle { height: 6px; }
            Rectangle {
                height: 34px;
                background: Tokens.card;
                border-radius: 4px;
                border-width: 1px;
                border-color: Tokens.stroke;
                opacity: root.find-disabled ? 0.55 : 1;
                Rectangle { y: parent.height - 2px; height: 1px; x: 3px; width: parent.width - 6px; background: Tokens.stroke-hi; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    find-input := TextInput {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        color: Tokens.text;
                        font-size: 13px;
                        single-line: true;
                        enabled: !root.find-disabled;
                        read-only: root.find-disabled;
                        text <=> root.find;
                        edited => { root.apply-find(self.text); }
                    }
                    if root.find != "" && !root.find-disabled: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: clear-ta.has-hover ? Tokens.subtle : transparent;
                            Icon { x: 3.5px; y: 3.5px; d: Icons.close; size: 11px; tint: Tokens.text3; sw: 2; }
                            clear-ta := TouchArea {
                                clicked => {
                                    root.find = "";
                                    root.apply-find("");
                                }
                            }
                        }
                    }
                    VerticalLayout { alignment: center; Icon { d: Icons.search; size: 14px; tint: Tokens.text3; sw: 2; } }
                }
                if root.find == "": Text {
                    x: 10px;
                    width: parent.width - 36px;
                    height: parent.height;
                    text: root.page == 3 ? "Search captures" : (root.page == 4 ? "Search workflows" : (root.page == 6 ? "Search tools" : "Search settings"));
                    color: Tokens.text3;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle { height: 11px; }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                Rectangle {
                    height: 40px;
                    background: Tokens.accent;
                    border-radius: 6px;
                    opacity: nc-ta.pressed ? 0.85 : (nc-ta.has-hover ? 0.92 : 1.0);
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        VerticalLayout { alignment: center; Icon { d: Icons.region; size: 16px; tint: Tokens.on-accent; sw: 1.8; } }
                        Text { horizontal-stretch: 1; text: "New capture"; color: Tokens.on-accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                        if SettingsState.capture-hotkey != "": Text {
                            text: SettingsState.capture-hotkey;
                            color: Tokens.on-accent;
                            font-size: 11px;
                            font-weight: 500;
                            opacity: 0.85;
                            vertical-alignment: center;
                        }
                    }
                    nc-ta := TouchArea { clicked => { SettingsState.run-capture(); } }
                }
            }
            Rectangle { height: 7px; }
            NavItem { label: "History"; icon: Icons.history; count: root.history-count; selected: root.page == 3; clicked => { root.page = 3; } }
            NavItem { label: "Workflows"; icon: Icons.workflows; selected: root.page == 4; clicked => { root.page = 4; } }
            NavItem { label: "Tools"; icon: Icons.tools; selected: root.page == 6; clicked => { root.page = 6; } }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout { padding-left: 12px; padding-top: 8px; padding-bottom: 4px; Text { text: "Settings"; color: Tokens.text3; font-size: 12px; font-weight: 600; } }
            NavItem { row-height: 40px; label: "General"; icon: Icons.gear; selected: root.page == 0; clicked => { root.page = 0; } }
            NavItem { row-height: 40px; label: "Capture"; icon: Icons.region; selected: root.page == 1; clicked => { root.page = 1; } }
            NavItem { row-height: 40px; label: "Hotkeys"; icon: Icons.grid; selected: root.page == 2; clicked => { root.page = 2; } }
            NavItem { row-height: 40px; label: "Upload destinations"; icon: Icons.cloud; selected: root.page == 5; clicked => { root.page = 5; } }
        }
        Rectangle {
            width: 6px;
            background: (div-ta.has-hover || div-ta.pressed) ? Tokens.stroke : transparent;
            div-ta := TouchArea {
                property <length> drag-start-x: 0px;
                mouse-cursor: col-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.drag-start-x = self.mouse-x;
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.nav-width = max(190px, min(360px, root.nav-width + (self.mouse-x - self.drag-start-x)));
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Tokens.layer;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Tokens.stroke;
            clip: true;
            if root.page == 3: HistoryPage {
                x: 1px;
                y: 1px;
                width: parent.width - 1px;
                height: parent.height - 1px;
                side: root.width >= 1050px;
                scroll-y: root.scroll-y;
            }
            if root.page != 3: Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 1px;
                height: parent.height - 1px;
                property <float> scroll-prop: root.scroll-y;
                property <int> page-prop: root.page;
                property <string> tools-panel-prop: ToolsState.active-panel;
                content-height: max(content.preferred-height + 68px, self.height);
                init => {
                    self.content-y = -1px * root.scroll-y;
                }
                changed scroll-prop => {
                    self.content-y = -1px * self.scroll-prop;
                }
                changed page-prop => {
                    self.content-y = 0px;
                }
                changed tools-panel-prop => {
                    self.content-y = 0px;
                }
                content := VerticalLayout {
                    x: root.page == 4 || root.page == 6 ? 24px : 40px;
                    y: 20px;
                    width: parent.width - (root.page == 4 || root.page == 6 ? 48px : 80px);
                    alignment: start;
                    if root.page == 0: GeneralPage { filter: root.settings-find; }
                    if root.page == 1: CapturePage { filter: root.settings-find; }
                    if root.page == 2: HotkeysPage { filter: root.settings-find; }
                    if root.page == 5: UploadsPage { filter: root.settings-find; }
                    if root.page == 4: WorkflowsPage { }
                    if root.page == 6: ToolsPage { }
                }
            }
        }
    }
    }
}
