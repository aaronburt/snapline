import { Tokens } from "tokens.slint";
import { Icons } from "icons.slint";
import { Logo, Icon } from "widgets.slint";

export struct PanelRecent {
    id: int,
    name: string,
    time: string,
    duration: string,
    uploaded: bool,
    thumb: image,
    has-thumb: bool,
}

export struct PanelUpload {
    id: int,
    name: string,
    detail: string,
    fraction: float,
    indeterminate: bool,
    cancellable: bool,
}

export global PanelState {
    in property <[PanelRecent]> recents;
    in property <[PanelUpload]> uploads;
    in property <bool> loaded: false;
    in property <string> link;
    in property <string> copy-label: "Copy";
    callback action(string);
    callback open-main(string);
    callback open-capture(int);
    callback copy-link();
    callback cancel-upload(int);
    callback close();
}

component HeaderButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: ta.has-hover ? Tokens.subtle : transparent;
    Icon { d: root.icon; size: 18px; tint: Tokens.text2; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Tile inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> accent: false;
    callback clicked();
    width: 75px;
    height: 56px;
    border-radius: 6px;
    background: root.accent ? Tokens.accent : Tokens.card;
    border-width: 1px;
    border-color: root.accent ? Tokens.accent : Tokens.stroke;
    Rectangle {
        border-radius: 6px;
        background: ta.pressed ? Tokens.subtle : (ta.has-hover ? Tokens.subtle : transparent);
    }
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout { alignment: center; Icon { d: root.icon; size: 20px; tint: root.accent ? Tokens.on-accent : Tokens.text; } }
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: 500;
            color: root.accent ? Tokens.on-accent : Tokens.text;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component RecentItem inherits Rectangle {
    in property <PanelRecent> item;
    callback clicked();
    width: 98px;
    height: 61px + 5px + 14px;
    border-radius: 4px;
    VerticalLayout {
        spacing: 5px;
        Rectangle {
            height: 61px;
            border-radius: 4px;
            background: Tokens.card-alt;
            border-width: 1px;
            border-color: Tokens.stroke;
            clip: true;
            if root.item.has-thumb: Image {
                width: parent.width;
                height: parent.height;
                source: root.item.thumb;
                image-fit: cover;
            }
            if root.item.duration != "": Rectangle {
                x: parent.width - self.width - 4px;
                y: parent.height - self.height - 4px;
                width: dur.preferred-width + 10px;
                height: 16px;
                border-radius: 3px;
                background: Tokens.overlay-pill;
                dur := Text { text: root.item.duration; font-size: 10px; color: Tokens.on-overlay; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { background: ta.has-hover ? Tokens.subtle : transparent; }
        }
        HorizontalLayout {
            height: 14px;
            spacing: 4px;
            if root.item.uploaded: VerticalLayout { alignment: center; Icon { d: Icons.link; size: 12px; tint: Tokens.ok; } }
            Text { text: root.item.time; font-size: 11px; color: Tokens.text3; vertical-alignment: center; overflow: elide; }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component UploadRow inherits HorizontalLayout {
    in property <PanelUpload> item;
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        Text { text: root.item.name; font-size: 12px; color: Tokens.text; overflow: elide; }
        Text { text: root.item.detail; font-size: 10px; color: Tokens.text3; overflow: elide; }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Tokens.track;
            Rectangle {
                x: 0;
                width: root.item.indeterminate ? parent.width * 0.3 : parent.width * root.item.fraction;
                height: parent.height;
                border-radius: 2px;
                background: Tokens.accent;
            }
        }
    }
    if root.item.cancellable: VerticalLayout {
        alignment: center;
        Rectangle {
            width: cancel-text.preferred-width + 14px;
            height: 24px;
            border-radius: 4px;
            background: Tokens.card;
            border-width: 1px;
            border-color: Tokens.stroke;
            Rectangle { border-radius: 4px; background: cancel-ta.has-hover ? Tokens.subtle : transparent; }
            cancel-text := Text { text: "Cancel"; font-size: 11px; color: Tokens.text2; horizontal-alignment: center; vertical-alignment: center; }
            cancel-ta := TouchArea { clicked => { PanelState.cancel-upload(root.item.id); } }
        }
    }
}

export component QuickPanelWindow inherits Window {
    title: "Snapline";
    no-frame: true;
    always-on-top: true;
    background: Tokens.layer;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 13px;
    width: 344px;
    out property <length> content-height: stack.preferred-height;

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                PanelState.close();
                return accept;
            }
            reject
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Tokens.stroke;
        stack := VerticalLayout {
            padding: 1px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 12px;
                VerticalLayout { alignment: center; Logo { size: 32px; } }
                Text { horizontal-stretch: 1; text: "Snapline"; font-size: 14px; font-weight: 600; color: Tokens.text; vertical-alignment: center; }
                HeaderButton { icon: Icons.open; clicked => { PanelState.open-main("/history"); } }
                HeaderButton { icon: Icons.gear-detail; clicked => { PanelState.open-main("/settings/general"); } }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: 12px;
                spacing: 6px;
                alignment: start;
                Tile { icon: Icons.region; label: "Region"; accent: true; clicked => { PanelState.action("capture_region"); } }
                Tile { icon: Icons.window; label: "Window"; clicked => { PanelState.action("capture_window"); } }
                Tile { icon: Icons.screen; label: "Screen"; clicked => { PanelState.action("capture_screen"); } }
            }
            Rectangle { height: 1px; background: Tokens.stroke; }
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 24px;
                    Text { horizontal-stretch: 1; text: "Recent"; font-size: 12px; font-weight: 500; color: Tokens.text3; vertical-alignment: center; }
                    Rectangle {
                        width: view-all.preferred-width;
                        view-all := Text { text: "View all"; font-size: 12px; color: Tokens.accent; vertical-alignment: center; }
                        TouchArea { clicked => { PanelState.open-main("/history"); } }
                    }
                }
                if PanelState.loaded && PanelState.recents.length == 0: Text { text: "No captures yet"; font-size: 12px; color: Tokens.text3; height: 16px; }
                if PanelState.recents.length > 0: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    for item in PanelState.recents: RecentItem { item: item; clicked => { PanelState.open-capture(item.id); } }
                }
            }
            if PanelState.uploads.length > 0: Rectangle { height: 1px; background: Tokens.stroke; }
            if PanelState.uploads.length > 0: VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 8px;
                Text { text: "Uploads"; font-size: 12px; font-weight: 500; color: Tokens.text3; }
                for upload in PanelState.uploads: UploadRow { item: upload; }
            }
            Rectangle {
                height: 49px;
                background: Tokens.mica;
                Rectangle { y: 0; height: 1px; background: Tokens.stroke; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    VerticalLayout { alignment: center; Text { text: "Last link"; font-size: 12px; color: Tokens.text3; } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text {
                            text: PanelState.link == "" ? "None yet" : PanelState.link;
                            font-size: 12px;
                            font-family: Tokens.mono;
                            color: Tokens.text2;
                            overflow: elide;
                        }
                    }
                    Rectangle {
                        width: 72px;
                        height: 32px;
                        border-radius: 4px;
                        background: Tokens.card;
                        border-width: 1px;
                        border-color: Tokens.stroke;
                        opacity: PanelState.link == "" ? 0.45 : 1;
                        Rectangle { border-radius: 4px; background: copy-ta.has-hover && PanelState.link != "" ? Tokens.subtle : transparent; }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            VerticalLayout { alignment: center; Icon { d: PanelState.copy-label == "Copied" ? Icons.check : Icons.copy; size: 14px; tint: Tokens.text; } }
                            VerticalLayout { alignment: center; Text { text: PanelState.copy-label; font-size: 12px; color: Tokens.text; } }
                        }
                        copy-ta := TouchArea {
                            enabled: PanelState.link != "";
                            clicked => { PanelState.copy-link(); }
                        }
                    }
                }
            }
        }
    }
}
